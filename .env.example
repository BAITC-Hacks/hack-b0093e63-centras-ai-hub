# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# === Supabase ===
# Project Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API → service_role (секрет! только сервер/CI)
SUPABASE_SERVICE_ROLE_KEY=
# Account → Access Tokens → Generate new token (для Supabase CLI: link, db push, functions deploy)
SUPABASE_ACCESS_TOKEN=
# Часть URL проекта: https://supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=
# Пароль БД, заданный при создании проекта (Project Settings → Database)
SUPABASE_DB_PASSWORD=

# === OpenAI (https://platform.openai.com/api-keys) ===
OPENAI_API_KEY=
# Модель консультанта (Chat Completions + tools)
OPENAI_MODEL=gpt-4.1-mini
# Модель эмбеддингов (1536 измерений — совпадает со схемой БД)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Скрапер ===
SCRAPER_CONCURRENCY=3
SCRAPER_DELAY_MS=300
# 1 = не собирать служебные страницы, закрытые robots.txt (FAQ, как заказать, оплата, возврат)
SCRAPER_SKIP_SERVICE_PAGES=0
# Ограничение числа URL (для отладки), 0 = без ограничения
SCRAPER_LIMIT=0
# Режим «одна категория» (для обновления seed/): только эта категория + N товаров из неё
SCRAPER_CATEGORY=/catalog/svetilniki_lampy/lampy/
SCRAPER_MAX_PRODUCTS=100

# === Edge Function (в прод задаются через `npx supabase secrets set ...`) ===
# Домены, с которых виджету разрешено обращаться к API (через запятую)
ALLOWED_ORIGINS=https://ekt.kz,https://www.ekt.kz,http://localhost:5173

# === Eval ===
# URL чата для `npm run eval` (по умолчанию ${SUPABASE_URL}/functions/v1/chat)
CHAT_URL=
