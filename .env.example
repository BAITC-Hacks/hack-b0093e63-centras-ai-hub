# === Supabase (Project Settings → API) ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Для Supabase CLI (Account → Access Tokens) и ref проекта
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Скрапер ===
SCRAPER_CONCURRENCY=3
SCRAPER_DELAY_MS=300
# 1 = не собирать служебные страницы, закрытые robots.txt (FAQ, как заказать, оплата, возврат)
SCRAPER_SKIP_SERVICE_PAGES=0
# Ограничение числа URL (для отладки), 0 = без ограничения
SCRAPER_LIMIT=0

# === Edge Function (задаются через `supabase secrets set`) ===
ALLOWED_ORIGINS=https://ekt.kz,https://www.ekt.kz,http://localhost:5173
